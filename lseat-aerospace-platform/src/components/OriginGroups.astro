---
/**
 * OriginGroups.astro - one presentation for both benefit pages.
 *
 * Renders a section head, the origin's own sub-headings, and the origin's own
 * bullet statements, with nothing added, removed or reordered. It is used twice,
 * for /passenger-benefits and for /airline-benefits, because the origin publishes
 * both pages with the identical heading-then-bullets structure.
 *
 * The source defects carried by the statements it renders are recorded in an HTML
 * comment at each call site in src/pages/index.astro.
 */
import type { OriginGroup } from '../legacy';

export interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  groups: readonly OriginGroup[];
  surface: 'deep-navy' | 'slate-dark';
}

const { id, eyebrow, title, groups, surface } = Astro.props;
---

<section
  id={id}
  class:list={[
    'origin-group relative scroll-mt-24 py-20 md:py-28',
    surface === 'deep-navy' ? 'bg-deep-navy' : 'bg-slate-dark',
  ]}
  aria-labelledby={`${id}-title`}
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
{eyebrow && <span class="section-badge">{eyebrow}</span>}
      <h2
        id={`${id}-title`}
        class="section-title font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
      >
        {title}
      </h2>
    </header>

    <div class="origin-grid mt-12 md:mt-16">
      {
        groups.map((group) => (
          <div class="origin-cell">
            <h3 class="origin-cell-head font-mono text-caption uppercase tracking-widest text-pure-white/60">
              {group.heading}
            </h3>
            <ul class="flex flex-col gap-4" role="list">
              {group.statements.map((statement) => (
                <li class="flex gap-4">
                  <span class="origin-tick" aria-hidden="true" />
                  <p class="verbatim text-body-base text-pure-white/90">{statement}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

  </div>
</section>

<style>
  /* Data-dense register: a hairline-framed cell grid, 1px dividers drawn with
     gap + background so the rules never need a border colour. */
  .origin-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .origin-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .origin-cell {
    background-color: #0b192c;
    padding: 1.5rem;
  }

  .origin-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }

  @media (min-width: 768px) {
    .origin-cell {
      padding: 2rem;
    }
  }

  .origin-cell-head {
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* 1px cyan tick in place of a bullet: restrained, technical, no glyph. */
  .origin-tick {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 1px;
    margin-top: 0.75em;
    background-color: rgba(0, 210, 254, 0.7);
  }
</style>