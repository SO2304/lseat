---
/**
 * Concept.astro - the (C) brochure statements, verbatim.
 *
 * Rendered copy: conceptTitle, conceptLead, conceptBody, rental. No sentence is
 * added, shortened or reworded; the rental paragraph is reproduced as one
 * continuous block exactly as the brochure carries it.
 */
import { conceptTitle, conceptLead, conceptBody, rental } from '../legacy';
---

<section
  id="concept"
  class="technical-panel relative scroll-mt-24 bg-slate-dark py-20 md:py-28"
  aria-labelledby="concept-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <span class="section-badge">Concept</span>
      <h2 id="concept-title" class="section-title text-balance">{conceptTitle}</h2>
      <p class="mt-6 font-mono text-body-lg text-electric-cyan text-balance">{conceptLead}</p>
    </header>

    <div class="technical-split mt-12 md:mt-16">
      <div class="technical-cell">
        <p class="text-body-lg text-pure-white/90 text-balance">{conceptBody}</p>
      </div>
      <div class="technical-cell">
        <p class="text-body-lg text-pure-white/90 text-balance">{rental}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hairline-framed cell grid: 1px rules drawn with gap + background so the
     dividers stay 1px at every breakpoint and never need a border colour. */
  .technical-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .technical-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .technical-cell {
    background-color: #0f172a;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .technical-cell {
      padding: 2rem;
    }
  }

  /* Corner tick, top left: the section's only decorative mark. */
  .technical-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }
</style>