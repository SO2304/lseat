---
/**
 * News.astro - the live /news page.
 *
 * The origin lists four entries and links four PDFs. The hrefs, as served, are
 * recorded beside each entry in legacy.ts. This deployment hosts ONE of the
 * four files, the IN FLIGHT magazine, so exactly one entry carries a link. The
 * other three render as their title text alone: the origin content is real and
 * is reported, but there is no file here to point at, and a link to a missing
 * file is not built. No placeholder label is rendered in their place, because
 * any such label would be copy the origin does not publish.
 *
 * The origin publishes no heading on this page above the list, so the page's
 * h1 is the origin's own nav label for this route, "NEWS", used verbatim.
 *
 * RETAINED SOURCE TYPOS, all from the live /news page:
 *   "reaseach"   "Abstract Medical reaseach thrombose in aviation"
 *   "4.656"      "Avoid 1 Thrombose/4.656 pax due to 4+ hours flights"
 *   "fundation"  "Dutch Thrombose fundation petition"
 * The owner instructed an exact mirror, so all three are reproduced as found.
 */
import { newsItems, downloadLabel } from '../legacy';
---

<section
  id="news"
  class="relative scroll-mt-24 bg-deep-navy py-16 md:py-24"
  aria-labelledby="news-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <h1
      id="news-title"
      class="section-title font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
    >
      NEWS
    </h1>

    <ul class="news-grid mt-12 md:mt-16" role="list">
      {
        newsItems.map((item) => (
          <li class="news-cell flex flex-col gap-3">
            <h2 class="font-mono text-body-base font-semibold leading-snug text-pure-white">
              {item.title}
            </h2>
            {item.subtitle && (
              <p class="verbatim text-body-sm text-pure-white/70">{item.subtitle}</p>
            )}
            {item.href && (
              <a
                href={item.href}
                download={item.download}
                type="application/pdf"
                class="news-link inline-flex min-h-12 items-center gap-2 font-mono text-body-sm text-electric-cyan"
              >
                <span>{downloadLabel}</span>
                <span class="text-pure-white/35" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <!--
      Legacy source typos retained deliberately. "reaseach" for "research",
      "4.656" and "fundation" are defects in the live /news page, reproduced as
      found because the owner instructed an exact mirror. Three of the four
      entries are not linked because this deployment does not host their files;
      no placeholder label is rendered in their place, since the origin publishes
      no label for them either beyond the download action.
    -->
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .news-cell {
    background-color: #0b192c;
    padding: 1.5rem;
  }

  .news-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }

  @media (min-width: 768px) {
    .news-cell {
      padding: 2rem;
    }
  }

  .news-link {
    width: fit-content;
    margin-top: auto;
    text-decoration: underline;
    text-decoration-color: rgba(0, 210, 254, 0.35);
    text-underline-offset: 0.3rem;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .news-link:hover {
    color: #ffffff;
    text-decoration-color: currentColor;
  }
</style>