---
/**
 * Footer.astro - site footer.
 *
 * The logo is the owner-supplied brand artwork (public/logo-lseat.png), identical
 * treatment to the header: same asset, same white plate, same 28px render height.
 *
 * The copyright line is the origin's own, reproduced character for character,
 * sign included: "Copyright (c) 2024 Lseat - All Rights Reserved." The year is
 * the origin's year and is not updated to the current one, because the line is a
 * transcription rather than a generated notice.
 *
 * The navigation block is the origin's own six labels, in the origin's order, and
 * every one of them is a real route on the origin: "/", "/passenger-benefits",
 * "/airline-benefits", "/compliances", "/news", "/contact". Those are the hrefs
 * used here, so the footer index lands on the same six pages the header does.
 * "Home" is the root-relative "/", which resolves from every depth, so the
 * footer Home works from every page too.
 *
 * The contact block is the /contact page's own content, including the owner's
 * confirmed address form and yh@lseat.eu, which is the only mailbox the origin
 * publishes. No other mailbox address is reproduced here.
 *
 * NOT REPRODUCED, and reported rather than silently dropped:
 *   - the origin's three social links. On the origin they are icon-only images
 *     with no text, so reproducing them here would mean inventing an accessible
 *     label. No destination is published on this site instead.
 *   - the cookie banner ("This website uses cookies.", "Decline", "Accept") and
 *     the "Powered by" line. Both are GoDaddy platform chrome, not editorial
 *     content, and this site sets no cookies.
 *
 * Touch targets: every interactive element here is at least 48px tall.
 */
import { Mail, MapPin, Phone } from '@lucide/astro';
import {
  homeHref,
  siteNav,
  companyName,
  directEmail,
  phoneDisplay,
  phoneDigits,
  addressLines,
  copyright,
} from '../legacy';
---

<footer class="glassmorphism border-t-2 border-t-electric-cyan/25 bg-deep-navy" role="contentinfo">
  <div class="section-container py-14 md:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <!-- min-h-12 tap target on the anchor; the white plate stays nested inside it
             so the plate and the 28px logo keep their original rendered size. -->
        <a href={homeHref} class="inline-flex min-h-12 items-center rounded-lg" aria-label="Home">
          <span
            class="inline-flex items-center rounded-lg bg-white px-2.5 py-1.5 shadow-sm ring-1 ring-black/10"
          >
            <img
              src="/logo-lseat.png"
              alt="LSEAT"
              width="40"
              height="28"
              class="h-7 w-auto"
              loading="eager"
              decoding="sync"
            />
          </span>
        </a>

        <nav aria-label="Main navigation" class="mt-8">
          <ul class="footer-nav" role="list">
            {
              siteNav.map((link) => (
                <li>
                  <a href={link.href} class="footer-nav-link font-mono">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="lg:col-span-7">
        <address class="not-italic">
          <p class="font-mono text-body-base font-semibold text-pure-white/90">{companyName}</p>

          <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2" role="list">
            <li class="flex items-start gap-3 text-body-sm text-pure-white/75">
              <MapPin class="mt-1 h-4 w-4 shrink-0 text-electric-cyan" stroke-width="1.75" aria-hidden="true" focusable="false" />
              <span class="verbatim">
                {addressLines.join('\n')}
              </span>
            </li>
            <li>
              <a
                href={'tel:' + phoneDigits}
                class="footer-line font-mono tabular-nums text-body-sm text-pure-white/75"
              >
                <Phone class="h-4 w-4 shrink-0 text-electric-cyan" stroke-width="1.75" aria-hidden="true" focusable="false" />
                {phoneDisplay}
              </a>
            </li>
            <li>
              <a
                href={'mailto:' + directEmail}
                class="footer-line font-mono tabular-nums text-body-sm text-pure-white/75"
              >
                <Mail class="h-4 w-4 shrink-0 text-electric-cyan" stroke-width="1.75" aria-hidden="true" focusable="false" />
                {directEmail}
              </a>
            </li>
          </ul>
        </address>
      </div>
    </div>

    <div class="mt-12 border-t border-pure-white/10 pt-6">
      <p class="verbatim font-mono text-caption uppercase text-pure-white/45">{copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-nav > li {
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
    transition: color 200ms ease, background-color 200ms ease;
  }

  .footer-nav-link:hover {
    color: #ffffff;
    background-color: rgba(0, 210, 254, 0.08);
  }

  .footer-line {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3rem;
    width: fit-content;
    text-decoration: underline;
    text-decoration-color: rgba(0, 210, 254, 0.3);
    text-underline-offset: 0.3rem;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .footer-line:hover {
    color: #ffffff;
    text-decoration-color: currentColor;
  }
</style>