---
/**
 * Hero.astro - the opening section of the origin's home page.
 *
 * Rendered copy, all from the live origin:
 *   - the h1 is the origin home page headline, runs of consecutive spaces
 *     included: "LSEAT inserts sleep mode on existing  Economy  seats pitch
 *     and cabin"
 *   - the four figures are lifted verbatim out of the live /compliances page,
 *     each recorded beside the sentence it is a substring of in legacy.ts
 *
 * THE BACKGROUND VIDEO IS GONE, deliberately. The MVI_9553 cabin clip this
 * deployment previously shipped as /media/hero-cabin.mp4, .webm and
 * hero-cabin-poster.jpg is NOT origin content. The origin's hero is its own
 * background-fill video, a Vimeo asset this project does not hold and does not
 * mirror, so under the mirror rule the local clip, its scrim and its playback
 * script were all removed rather than passed off as the origin's own. With the
 * clip gone the scrim has nothing to darken, and with the scrim gone the
 * playback script has nothing to attach, so the section is now a static
 * gradient plus the design system's grid. This also removes the last large
 * binaries from public/.
 *
 * The origin's own "How it works...(video)" film is republished where the
 * origin publishes it, as the origin's own Vimeo iframe, in HowItWorks.astro.
 */
import { homeHeadline, heroFigures } from '../legacy';
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-deep-navy text-pure-white"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(ellipse 90% 70% at 50% 0%, rgba(2, 132, 199, 0.28) 0%, rgba(2, 132, 199, 0) 62%);"
    >
    </div>
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(180deg, rgba(11, 25, 44, 0) 0%, rgba(11, 25, 44, 0) 55%, rgba(11, 25, 44, 0.6) 100%);"
    >
    </div>
    <div class="absolute inset-0 bg-grid-pattern bg-grid-64 opacity-70"></div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[220px]" aria-hidden="true">
    <svg
      class="h-full w-full"
      viewBox="0 0 1440 220"
      preserveAspectRatio="none"
      focusable="false"
      role="presentation"
    >
      <defs>
        <linearGradient id="lseat-horizon" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#00D2FE" stop-opacity="0"></stop>
          <stop offset="22%" stop-color="#00D2FE" stop-opacity="0.22"></stop>
          <stop offset="50%" stop-color="#00D2FE" stop-opacity="0.5"></stop>
          <stop offset="78%" stop-color="#00D2FE" stop-opacity="0.22"></stop>
          <stop offset="100%" stop-color="#00D2FE" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="lseat-haze" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0284C7" stop-opacity="0"></stop>
          <stop offset="100%" stop-color="#0284C7" stop-opacity="0.12"></stop>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="1440" height="220" fill="url(#lseat-haze)"></rect>
      <path d="M0 158 C 260 140, 420 126, 720 119 C 1020 126, 1180 140, 1440 158" fill="none" stroke="url(#lseat-horizon)" stroke-width="1"></path>
      <path d="M0 176 C 300 160, 460 150, 720 144 C 980 150, 1140 160, 1440 176" fill="none" stroke="url(#lseat-horizon)" stroke-width="1" stroke-opacity="0.45"></path>
      <path d="M0 198 C 340 186, 500 178, 720 174 C 940 178, 1100 186, 1440 198" fill="none" stroke="url(#lseat-horizon)" stroke-width="1" stroke-opacity="0.22"></path>
    </svg>
  </div>

  <div class="section-container relative py-12 md:py-20 lg:py-24">
    <div class="max-w-4xl">
      <p class="hero-rule"><span class="badge-cert">LSEAT</span></p>

      <h1
        id="hero-title"
        class="verbatim mt-5 font-display text-pure-white text-balance text-[clamp(2rem,6.2vw,4rem)] font-extrabold leading-[1.05] tracking-tight"
      >
        {homeHeadline}
      </h1>

      <ul
        class="hero-figures mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-electric-cyan/22 bg-electric-cyan/22 lg:mt-12 lg:grid-cols-4"
        aria-label="Technical aspects"
      >
        {
          heroFigures.map((figure) => (
            <li class="flex flex-col gap-2 bg-slate-dark/90 px-4 py-4 sm:px-5 sm:py-5">
              <span class="text-caption text-pure-white/55">{figure.label}</span>
              <span class="font-mono text-body-lg font-semibold tabular-nums text-electric-cyan sm:text-display-sm">
                {figure.value}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* The .badge-cert chip plus a short trailing hairline. .badge-cert keeps its
     #FFFFFF text: over the brightest composited chip pixel it measures 9.28:1.
     Do not change it to a sky tone, which measures 4.33:1 and fails. */
  .hero-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-rule::after {
    content: '';
    display: block;
    height: 1px;
    width: 3rem;
    background-color: rgba(0, 210, 254, 0.55);
  }

  /* Staggered CSS-only entrance: no observer, no counter, no script. The four
     figures are phrases, not numbers, so nothing here needs to count. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-figures > li {
      animation: hero-figure-in 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero-figures > li:nth-child(1) { animation-delay: 60ms; }
    .hero-figures > li:nth-child(2) { animation-delay: 140ms; }
    .hero-figures > li:nth-child(3) { animation-delay: 220ms; }
    .hero-figures > li:nth-child(4) { animation-delay: 300ms; }
  }

  @keyframes hero-figure-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>