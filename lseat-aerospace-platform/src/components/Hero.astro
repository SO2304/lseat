---
/**
 * Hero.astro - the opening section.
 *
 * Rendered copy, all from the live origin:
 *   - the h1 is the origin home page headline, runs of consecutive spaces included
 *   - the two calls to action are origin navigation labels that resolve to real
 *     sections of this page
 *   - the four figures are lifted verbatim out of the live /compliances page
 *   - the "See Flyer" link is the origin label for the 2025 brochure, which this
 *     site does host
 *
 * The hero background video and its deferral logic are unchanged: the element
 * carries preload="none" and no <source> children, so the resource selection
 * algorithm has nothing to fetch, and a synchronous inline script strips
 * autoplay and loop for prefers-reduced-motion, save-data and 2g/slow-2g before
 * any playback can begin.
 */
import { homeHeadline, homeLink, heroFigures, brochureHref, brochureDownload, downloadLabel, siteNav } from '../legacy';

const cta = [
  { label: 'Compliances', href: '#compliances' },
  { label: 'Contact', href: '#contact' },
] as const;
const primary = siteNav.find((item) => item.label === cta[0].label) ?? siteNav[0];
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-deep-navy text-pure-white"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <video
      id="hero-video"
      data-hero-video
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      poster="/media/hero-cabin-poster.jpg"
      preload="none"
      muted
      playsinline
      loop
      autoplay
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      disableRemotePlayback
    >
    </video>

    <script is:inline>
      (function () {
        var video = document.getElementById('hero-video');
        if (!video) return;

        var motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        var connection = navigator.connection;
        var saveData = !!(connection && connection.saveData);
        var slowLink =
          !!connection &&
          (connection.effectiveType === '2g' || connection.effectiveType === 'slow-2g');

        if (motion.matches || saveData || slowLink) {
          // Runs synchronously during parse. The element carries preload="none"
          // and no source children, so the resource selection algorithm has
          // nothing to fetch and no frame can decode: stripping the flags here
          // is unconditionally before any playback begins.
          video.removeAttribute('autoplay');
          video.removeAttribute('loop');
          video.setAttribute('data-hero-motion', 'poster-only');
        } else {
          video.setAttribute('data-hero-motion', 'eligible');
        }
      })();
    </script>

    <div class="absolute inset-0" data-hero-scrim="base"></div>
    <div class="absolute inset-0" data-hero-scrim="text"></div>
    <div class="absolute inset-0" data-hero-scrim="edge"></div>

    <div class="absolute inset-0 bg-grid-pattern bg-grid-64 opacity-70"></div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[220px]" aria-hidden="true">
    <svg
      class="h-full w-full"
      viewBox="0 0 1440 220"
      preserveAspectRatio="none"
      focusable="false"
      role="presentation"
    >
      <defs>
        <linearGradient id="lseat-horizon" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#00D2FE" stop-opacity="0"></stop>
          <stop offset="22%" stop-color="#00D2FE" stop-opacity="0.22"></stop>
          <stop offset="50%" stop-color="#00D2FE" stop-opacity="0.5"></stop>
          <stop offset="78%" stop-color="#00D2FE" stop-opacity="0.22"></stop>
          <stop offset="100%" stop-color="#00D2FE" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="lseat-haze" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0284C7" stop-opacity="0"></stop>
          <stop offset="100%" stop-color="#0284C7" stop-opacity="0.12"></stop>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="1440" height="220" fill="url(#lseat-haze)"></rect>
      <path d="M0 158 C 260 140, 420 126, 720 119 C 1020 126, 1180 140, 1440 158" fill="none" stroke="url(#lseat-horizon)" stroke-width="1"></path>
      <path d="M0 176 C 300 160, 460 150, 720 144 C 980 150, 1140 160, 1440 176" fill="none" stroke="url(#lseat-horizon)" stroke-width="1" stroke-opacity="0.45"></path>
      <path d="M0 198 C 340 186, 500 178, 720 174 C 940 178, 1100 186, 1440 198" fill="none" stroke="url(#lseat-horizon)" stroke-width="1" stroke-opacity="0.22"></path>
    </svg>
  </div>

  <div class="section-container relative py-12 md:py-20 lg:py-24">
    <div class="max-w-4xl">
      <p class="hero-rule"><span class="badge-cert">LSEAT</span></p>

      <h1
        id="hero-title"
        class="verbatim mt-5 font-display text-pure-white text-balance text-[clamp(2rem,6.2vw,4rem)] font-extrabold leading-[1.05] tracking-tight"
      >
        {homeHeadline}
      </h1>

      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a href={primary.href} class="btn-primary">{primary.label}</a>
        <a href={cta[1].href} class="btn-secondary">{cta[1].label}</a>
      </div>

      <p class="mt-7 font-mono text-body-sm">
        <a
          href={brochureHref}
          download={brochureDownload}
          type="application/pdf"
          class="inline-flex min-h-12 items-center gap-2 text-electric-cyan underline decoration-electric-cyan/40 underline-offset-4 transition-colors duration-200 hover:text-pure-white hover:decoration-pure-white"
        >
          <span>{homeLink}</span>
          <span class="text-pure-white/45" aria-hidden="true">/</span>
          <span class="text-pure-white/70">{downloadLabel}</span>
        </a>
      </p>
    </div>

    <ul
      class="hero-figures mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-electric-cyan/22 bg-electric-cyan/22 lg:mt-12 lg:grid-cols-4"
      aria-label="Technical aspects"
    >
      {
        heroFigures.map((figure) => (
          <li class="flex flex-col gap-2 bg-slate-dark/90 px-4 py-4 sm:px-5 sm:py-5">
            <span class="text-caption text-pure-white/55">{figure.label}</span>
            <span class="font-mono text-body-lg font-semibold tabular-nums text-electric-cyan sm:text-display-sm">
              {figure.value}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Flat deep-navy tint, folded in from the section's own #0B192C. 0.50 is the
     lightest round value that holds the measured contrast floor once every
     retained glow layer is accounted for. */
  [data-hero-scrim='base'] {
    background-color: rgba(11, 25, 44, 0.5);
  }

  [data-hero-scrim='text'] {
    background-image: radial-gradient(
      ellipse 78% 62% at 50% 40%,
      rgba(7, 17, 31, 0.58) 0%,
      rgba(7, 17, 31, 0.58) 52%,
      rgba(7, 17, 31, 0.42) 82%,
      rgba(7, 17, 31, 0.42) 100%
    );
  }

  [data-hero-scrim='edge'] {
    background-image: linear-gradient(
      180deg,
      rgba(11, 25, 44, 0.45) 0%,
      rgba(11, 25, 44, 0) 22%,
      rgba(11, 25, 44, 0) 55%,
      rgba(11, 25, 44, 0.6) 100%
    );
  }

  @media (min-width: 1024px) {
    [data-hero-video] {
      filter: blur(2px);
      transform: scale(1.05);
    }
  }

  /* The .badge-cert chip plus a short trailing hairline. .badge-cert keeps its
     #FFFFFF text: that is the colour measured at 9.28:1 against the brightest
     composited chip pixel over every frame of the hero clip. Do not change it
     to a sky tone, which measures 4.33:1 and fails. */
  .hero-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-rule::after {
    content: '';
    display: block;
    height: 1px;
    width: 3rem;
    background-color: rgba(0, 210, 254, 0.55);
  }

  /* Staggered CSS-only entrance: no observer, no counter, no script. The four
     figures are phrases, not numbers, so nothing here needs to count. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-figures > li {
      animation: hero-figure-in 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero-figures > li:nth-child(1) { animation-delay: 60ms; }
    .hero-figures > li:nth-child(2) { animation-delay: 140ms; }
    .hero-figures > li:nth-child(3) { animation-delay: 220ms; }
    .hero-figures > li:nth-child(4) { animation-delay: 300ms; }
  }

  @keyframes hero-figure-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  interface NetworkInformationLike {
    saveData?: boolean;
    effectiveType?: string;
  }

  type IdleWindow = Window & {
    requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
  };

  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (heroVideo && heroVideo.getAttribute('data-hero-motion') === 'eligible') {
    const heroSources: ReadonlyArray<{ src: string; type: string }> = [
      { src: '/media/hero-cabin.webm', type: 'video/webm; codecs="vp9"' },
      { src: '/media/hero-cabin.mp4', type: 'video/mp4; codecs="avc1.640029"' },
    ];

    const getConnection = (): NetworkInformationLike | undefined =>
      (navigator as Navigator & { connection?: NetworkInformationLike }).connection;

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

    const shouldSuppress = (): boolean => {
      if (motionPreference.matches) return true;
      const connection = getConnection();
      if (!connection) return false;
      return (
        connection.saveData === true ||
        connection.effectiveType === '2g' ||
        connection.effectiveType === 'slow-2g'
      );
    };

    let attached = false;
    let scheduled = false;
    let isHeroNearViewport = true;

    const startPlayback = (): void => {
      if (!heroVideo.paused) return;
      heroVideo.play().catch(() => {
        /* autoplay refused: the poster remains the experience */
      });
    };

    const attachSources = (): void => {
      if (attached || shouldSuppress()) return;
      attached = true;

      heroVideo.muted = true;
      heroVideo.defaultMuted = true;

      heroSources.forEach((source) => {
        const element = document.createElement('source');
        element.src = source.src;
        element.type = source.type;
        heroVideo.appendChild(element);
      });

      heroVideo.load();

      if (isHeroNearViewport) {
        startPlayback();
      } else {
        heroVideo.pause();
      }
    };

    const scheduleAttach = (): void => {
      if (scheduled || attached) return;
      scheduled = true;

      const idleWindow = window as IdleWindow;
      const run = (): void => {
        scheduled = false;
        attachSources();
      };

      if (typeof idleWindow.requestIdleCallback === 'function') {
        idleWindow.requestIdleCallback(run, { timeout: 2000 });
      } else {
        window.setTimeout(run, 1);
      }
    };

    if ('IntersectionObserver' in window) {
      const heroObserver = new IntersectionObserver(
        (observed) => {
          const entry = observed[0];
          if (!entry) return;
          isHeroNearViewport = entry.isIntersecting;

          if (entry.isIntersecting) {
            if (attached) {
              if (!shouldSuppress()) startPlayback();
            } else {
              scheduleAttach();
            }
            return;
          }

          if (attached && !heroVideo.paused) heroVideo.pause();
        },
        { rootMargin: '150% 0px' }
      );

      heroObserver.observe(heroVideo);
    } else {
      scheduleAttach();
    }

    const onMotionChange = (): void => {
      if (motionPreference.matches) {
        heroVideo.pause();
        heroVideo.removeAttribute('loop');
      }
    };

    if (typeof motionPreference.addEventListener === 'function') {
      motionPreference.addEventListener('change', onMotionChange);
    }
  }
</script>