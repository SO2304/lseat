---
/**
 * Benefits.astro - the remaining (C) brochure statements, verbatim.
 *
 * Rendered copy: the first brochure headline becomes the section title, and the
 * other two blocks fill the two-cell grid below it. No string is duplicated and
 * none is added. The third block is titled with the bare product name, which is
 * the only legacy string that introduces the maintenance statement without
 * adding words.
 */
import { benefitBlocks } from '../legacy';

const [headline, ...grid] = benefitBlocks;
---

<section
  id="benefits"
  class="technical-panel relative scroll-mt-24 bg-deep-navy py-20 md:py-28"
  aria-labelledby="benefits-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <h2
        id="benefits-title"
        class="font-display text-pure-white text-balance text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold leading-[1.12] tracking-tight"
      >
        {headline?.title}
      </h2>
      {headline?.statements.map((statement) => (
        <p class="mt-5 max-w-3xl font-mono text-body-base text-electric-cyan text-balance sm:text-body-lg">
          {statement}
        </p>
      ))}
    </header>

    <ul class="technical-split mt-12 md:mt-16" role="list">
      {
        grid.map((block) => (
          <li class="technical-cell flex flex-col gap-4">
            <h3 class="font-mono text-body-base font-semibold uppercase leading-snug tracking-wider text-electric-cyan">
              {block.title}
            </h3>
            {block.statements.map((statement) => (
              <p class="text-body-base text-pure-white/85 text-balance">{statement}</p>
            ))}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Hairline-framed cell grid: 1px rules drawn with gap + background so the
     dividers stay 1px at every breakpoint and never need a border colour. */
  .technical-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .technical-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .technical-cell {
    background-color: #0b192c;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .technical-cell {
      padding: 2rem;
    }
  }

  .technical-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }
</style>