---
/**
 * ContactForm.astro - the live /contact page, rebuilt.
 *
 * The origin form is "Send us an Email" with a Name field, an Email* field and a
 * Send button. This form matches that: two fields, one required marker, one
 * button, and the origin's own labels. None of the previous platform's
 * machinery is here and none of its copy survives - no enquiry categories, no
 * organisation, fleet, aircraft or job-title fields, no freemail block and its
 * override, no GDPR or newsletter checkboxes, no placeholders, no success panel,
 * no toasts.
 *
 * The submission pipeline is unchanged: the same Web3Forms endpoint, the same
 * PUBLIC_WEB3FORMS_KEY, the same hidden botcheck honeypot field name. What is
 * gone is the copy and the surplus fields, not the plumbing.
 *
 * THE ORIGIN'S GOOGLE reCAPTCHA NOTICE IS NOT REPRODUCED. The origin prints
 * "This site is protected by reCAPTCHA and the Google Privacy Policy and Terms
 * of Service apply." That sentence is accurate on the origin and would not be
 * accurate here, because reCAPTCHA is not enabled on this deployment. Publishing
 * an anti-spam protection claim that is not in force would be an unsourced
 * claim, which is the one thing this build refuses to do. Web3Forms can enable
 * reCAPTCHA v3 from its own dashboard with the same access key; if the owner
 * turns it on, the notice can be restored.
 *
 * The origin's "Office hours / Today / By Appointment / Get directions" block is
 * GoDaddy business-hours chrome rather than editorial content, and "Get
 * directions" would need a maps destination that is not published anywhere, so
 * it is not reproduced.
 */
import { MapPin, Mail, Phone } from '@lucide/astro';
import {
  contactTitle,
  contactLead,
  formNameLabel,
  formEmailLabel,
  formRequiredMark,
  formSubmitLabel,
  companyName,
  directEmail,
  phoneDisplay,
  phoneDigits,
  addressLines,
} from '../legacy';

const web3formsKey: string = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const ENDPOINT = 'https://api.web3forms.com/submit';
---

<section
  id="contact"
  class="relative scroll-mt-24 bg-slate-dark py-20 md:py-28"
  aria-labelledby="contact-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <h2
        id="contact-title"
        class="section-title font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
      >
        {contactTitle}
      </h2>
      <p class="mt-5 font-mono text-body-base text-electric-cyan sm:text-body-lg">{contactLead}</p>
    </header>

    <div class="contact-grid mt-12 md:mt-16">
      <div class="contact-cell">
        <form
          id="lseat-contact-form"
          method="POST"
          action={ENDPOINT}
          data-access-key={web3formsKey}
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Contact" />
          <input type="hidden" name="from_name" value="LSEAT" />

          <!-- Honeypot: if it is filled the submission is abandoned. Same field
               name Web3Forms already expects, so the existing dashboard setting
               keeps working unchanged. -->
          <div class="hidden" aria-hidden="true">
            <label for="lseat-botcheck">botcheck</label>
            <input type="text" id="lseat-botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label class="label-field flex min-h-12 items-center font-mono" for="lseat-name">
              {formNameLabel}
            </label>
            <input
              type="text"
              id="lseat-name"
              name="name"
              class="input-field font-mono"
              autocomplete="name"
            />
          </div>

          <div>
            <label class="label-field flex min-h-12 items-center font-mono" for="lseat-email">
              {formEmailLabel}<span class="text-electric-cyan" aria-hidden="true">{formRequiredMark}</span>
            </label>
            <input
              type="email"
              id="lseat-email"
              name="email"
              class="input-field font-mono"
              required
              autocomplete="email"
              inputmode="email"
              aria-required="true"
            />
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">{formSubmitLabel}</button>
        </form>
      </div>

      <div id="lseat-contact-details" class="contact-cell flex flex-col gap-5" tabindex="-1">
        <p class="font-mono text-body-base font-semibold text-pure-white">{companyName}</p>

        <address class="flex items-start gap-3 not-italic">
          <MapPin class="mt-1 h-4 w-4 shrink-0 text-electric-cyan" stroke-width="1.75" aria-hidden="true" focusable="false" />
          <span class="verbatim text-body-base text-pure-white/90">
            {addressLines.join('\n')}
          </span>
        </address>

        <a
          href={'tel:' + phoneDigits}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >
          <Phone class="h-4 w-4 shrink-0" stroke-width="1.75" aria-hidden="true" focusable="false" />
          {phoneDisplay}
        </a>

        <a
          href={'mailto:' + directEmail}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >
          <Mail class="h-4 w-4 shrink-0" stroke-width="1.75" aria-hidden="true" focusable="false" />
          {directEmail}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const ENDPOINT = 'https://api.web3forms.com/submit';

  const initContactForm = (): void => {
    const form = document.getElementById('lseat-contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.lseatReady === 'true') return;
    form.dataset.lseatReady = 'true';

    const details = document.getElementById('lseat-contact-details');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
    const accessKey = (form.getAttribute('data-access-key') || '').trim();

    form.addEventListener('submit', (event: Event) => {
      event.preventDefault();

      /* Honeypot: silent abort, no request emitted. */
      if (honeypot && honeypot.value.trim() !== '') {
        form.reset();
        return;
      }

      if (accessKey === '') return;

      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        payload[key] = String(value);
      });
      payload.access_key = accessKey;
      payload.botcheck = '';

      void fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        redirect: 'follow',
      })
        .then((response) => {
          if (!response.ok) return;
          /* No success copy exists on the origin, so the form steps aside and
             the direct contact channels become the terminal state of the
             interaction. */
          form.hidden = true;
          if (details instanceof HTMLElement) details.focus();
        })
        .catch(() => {
          /* Left untouched on failure: the form stays exactly as it was. */
        });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true });
  } else {
    initContactForm();
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .contact-cell {
    background-color: #0f172a;
    padding: 1.5rem;
  }

  .contact-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }

  @media (min-width: 768px) {
    .contact-cell {
      padding: 2rem;
    }
  }

  /* 48px minimum touch target on every contact link. */
  .contact-line {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3rem;
    width: fit-content;
    text-decoration: underline;
    text-decoration-color: rgba(0, 210, 254, 0.35);
    text-underline-offset: 0.3rem;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .contact-line:hover {
    color: #ffffff;
    text-decoration-color: currentColor;
  }

  #lseat-contact-details:focus {
    outline: none;
  }

  #lseat-contact-details:focus-visible {
    outline: 2px solid #00d2fe;
    outline-offset: 4px;
  }
</style>