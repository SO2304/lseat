---
/**
 * ContactForm.astro - the live /contact page, rebuilt.
 *
 * THE LABELS ARE THE ORIGIN'S, THE PIPELINE IS OURS. The origin's form is
 * "Send us an Email" with a field labelled "Name", a field labelled "Email*"
 * and a button labelled "Send". Those three labels and that lead are the
 * origin's own and are reproduced exactly. The submission pipeline underneath is
 * this deployment's: the same Web3Forms endpoint, the same
 * PUBLIC_WEB3FORMS_KEY, and the same hidden "botcheck" honeypot field name, so
 * the existing Web3Forms dashboard setting keeps working untouched. Labels from
 * one system, transport from the other, and the two are never conflated.
 *
 * ADDRESS. The origin prints "15, av. Arnaud Fraiteur," / "1050 BRUSSELS
 * (Belgium)". The owner has separately confirmed the correct form as
 * "15/23 Avenue Arnaud Fraiteur, 1050 Brussels, Belgium", and that is what is
 * published here. The origin's own address, street number 15 with no house
 * suffix and the postcode and city in full capitals, is not reproduced.
 *
 * NOT REPRODUCED, and reported rather than silently dropped:
 *
 *   - the Google reCAPTCHA notice. The origin prints "This site is protected by
 *     reCAPTCHA and the Google Privacy Policy and Terms of Service apply." That
 *     sentence is true on the origin and would be false here: reCAPTCHA is NOT
 *     enabled on this deployment, so publishing it would be an unsourced
 *     anti-spam protection claim on a site that has none. Web3Forms can enable
 *     reCAPTCHA v3 from its own dashboard with the same access key; if the owner
 *     turns it on, the notice can be restored.
 *
 *   - "Get directions". On the origin it is a bare <button> with no href
 *     anywhere in the served HTML: GoDaddy's script builds the maps URL at run
 *     time from the address, and no destination is ever published. Inventing one
 *     would be fabrication, so the control is omitted.
 *
 *   - "By Appointment". The string appears ZERO times in the served markup of
 *     all six origin pages. The office hours block the origin does print is
 *     "Office hours", "Open today" and "09:00 am - 05:00 pm", and only that is
 *     reproduced.
 *
 *   - the second, general mailbox address that appears in earlier revisions of this
 *     file. The origin does not publish it, so it is not published here. The only
 *     mailbox on the origin is yh@lseat.eu, and that is the only one here.
 */
import { MapPin, Mail, Phone } from '@lucide/astro';
import {
  contactTitle,
  contactLead,
  formNameLabel,
  formEmailLabel,
  formRequiredMark,
  formSubmitLabel,
  companyName,
  directEmail,
  phoneDisplay,
  phoneDigits,
  addressLines,
  officeHoursTitle,
  officeHoursDayLabel,
  officeHoursValue,
} from '../legacy';

const web3formsKey: string = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const ENDPOINT = 'https://api.web3forms.com/submit';
---

<section
  id="contact"
  class="relative scroll-mt-24 bg-slate-dark py-16 md:py-24"
  aria-labelledby="contact-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <h1
        id="contact-title"
        class="section-title font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
      >
        {contactTitle}
      </h1>
      <p class="mt-5 font-mono text-body-base text-electric-cyan sm:text-body-lg">{contactLead}</p>
    </header>

    <div class="contact-grid mt-12 md:mt-16">
      <div class="contact-cell">
        <form
          id="lseat-contact-form"
          method="POST"
          action={ENDPOINT}
          data-access-key={web3formsKey}
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Contact" />
          <input type="hidden" name="from_name" value="LSEAT" />

          <!-- Honeypot: if it is filled the submission is abandoned. Same field
               name Web3Forms already expects, so the existing dashboard setting
               keeps working unchanged. The wrapper is hidden and aria-hidden, so
               the field is out of the tab order and out of the accessibility
               tree while remaining a working server-side trap. -->
          <div class="hidden" aria-hidden="true">
            <label for="lseat-botcheck">botcheck</label>
            <input type="text" id="lseat-botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label class="label-field flex min-h-12 items-center font-mono" for="lseat-name">
              {formNameLabel}
            </label>
            <input
              type="text"
              id="lseat-name"
              name="name"
              class="input-field font-mono"
              autocomplete="name"
            />
          </div>

          <div>
            <label class="label-field flex min-h-12 items-center font-mono" for="lseat-email">
              {formEmailLabel}<span class="text-electric-cyan" aria-hidden="true">{formRequiredMark}</span>
            </label>
            <input
              type="email"
              id="lseat-email"
              name="email"
              class="input-field font-mono"
              required
              autocomplete="email"
              inputmode="email"
              aria-required="true"
            />
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">{formSubmitLabel}</button>
        </form>
      </div>

      <div id="lseat-contact-details" class="contact-cell flex flex-col gap-5" tabindex="-1">
        <p class="font-mono text-body-base font-semibold text-pure-white">{companyName}</p>

        <address class="flex items-start gap-3 not-italic">
          <MapPin class="mt-1 h-4 w-4 shrink-0 text-electric-cyan" stroke-width="1.75" aria-hidden="true" focusable="false" />
          <span class="verbatim text-body-base text-pure-white/90">
            {addressLines.join('\n')}
          </span>
        </address>

        <a
          href={'tel:' + phoneDigits}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >
          <Phone class="h-4 w-4 shrink-0" stroke-width="1.75" aria-hidden="true" focusable="false" />
          {phoneDisplay}
        </a>

        <a
          href={'mailto:' + directEmail}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >
          <Mail class="h-4 w-4 shrink-0" stroke-width="1.75" aria-hidden="true" focusable="false" />
          {directEmail}
        </a>

        <div class="mt-2 border-t border-pure-white/10 pt-5">
          <h2 class="font-mono text-caption uppercase tracking-widest text-pure-white/60">
            {officeHoursTitle}
          </h2>
          <dl class="mt-3 flex flex-col gap-1 font-mono text-body-sm">
            <div class="flex flex-wrap items-baseline gap-x-3">
              <dt class="text-pure-white/70">{officeHoursDayLabel}</dt>
              <dd class="tabular-nums text-pure-white/90">{officeHoursValue}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const ENDPOINT = 'https://api.web3forms.com/submit';

  const initContactForm = (): void => {
    const form = document.getElementById('lseat-contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.lseatReady === 'true') return;
    form.dataset.lseatReady = 'true';

    const details = document.getElementById('lseat-contact-details');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
    const accessKey = (form.getAttribute('data-access-key') || '').trim();

    form.addEventListener('submit', (event: Event) => {
      event.preventDefault();

      /* Honeypot: silent abort, no request emitted. */
      if (honeypot && honeypot.value.trim() !== '') {
        form.reset();
        return;
      }

      if (accessKey === '') return;

      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        payload[key] = String(value);
      });
      payload.access_key = accessKey;
      payload.botcheck = '';

      void fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        redirect: 'follow',
      })
        .then((response) => {
          if (!response.ok) return;
          /* No success copy exists on the origin, so the form steps aside and
             the direct contact channels become the terminal state of the
             interaction. */
          form.hidden = true;
          if (details instanceof HTMLElement) details.focus();
        })
        .catch(() => {
          /* Left untouched on failure: the form stays exactly as it was. */
        });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true });
  } else {
    initContactForm();
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .contact-cell {
    background-color: #0f172a;
    padding: 1.5rem;
  }

  .contact-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }

  @media (min-width: 768px) {
    .contact-cell {
      padding: 2rem;
    }
  }

  /* 48px minimum touch target on every contact link. */
  .contact-line {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3rem;
    width: fit-content;
    text-decoration: underline;
    text-decoration-color: rgba(0, 210, 254, 0.35);
    text-underline-offset: 0.3rem;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .contact-line:hover {
    color: #ffffff;
    text-decoration-color: currentColor;
  }

  #lseat-contact-details:focus {
    outline: none;
  }

  #lseat-contact-details:focus-visible {
    outline: 2px solid #00d2fe;
    outline-offset: 4px;
  }
</style>