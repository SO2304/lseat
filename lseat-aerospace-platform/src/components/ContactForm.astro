---
/**
 * ContactForm.astro - the 2020 contact block, rebuilt.
 *
 * The 2020 capture carried a minimal form: one required `Email*` field and a
 * `Send` button, with `yh@lseat.eu` and `+32 473 987 988` beneath it and the
 * company line `LSEAT Cy`. That is what is rendered here. The v5.0 form's ten
 * fields, its category selects, its fleet and aircraft-count inputs, its GDPR and
 * newsletter consent copy, its business-address filter, its success panel and its
 * toast strings were all written for the previous platform and none of that copy
 * is in the legacy source, so all of it is gone.
 *
 * The submission pipeline is unchanged: the same Web3Forms endpoint, the same
 * PUBLIC_WEB3FORMS_KEY, the same honeypot field name. What is removed is the copy,
 * not the plumbing.
 */
import { MapPin } from '@lucide/astro';
import {
  formFieldLabel,
  formRequiredMark,
  formSubmitLabel,
  directEmail,
  generalEmail,
  phoneDisplay,
  phoneDigits,
  companyLine,
} from '../legacy';

const web3formsKey: string = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const ENDPOINT = 'https://api.web3forms.com/submit';
---

<section
  id="contact"
  class="technical-panel relative scroll-mt-24 bg-deep-navy py-20 md:py-28"
  aria-labelledby="contact-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <h2
        id="contact-title"
        class="section-title font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
      >
        Contact
      </h2>
    </header>

    <div class="technical-split mt-12 md:mt-16">
      <div class="technical-cell">
        <form
          id="lseat-contact-form"
          method="POST"
          action={ENDPOINT}
          data-access-key={web3formsKey}
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Contact" />
          <input type="hidden" name="from_name" value="LSEAT" />

          <!-- Honeypot: if it is filled the submission is abandoned. Same field
               name Web3Forms already expects, so the existing dashboard setting
               keeps working unchanged. -->
          <div class="hidden" aria-hidden="true">
            <label for="lseat-botcheck">Do not fill this field</label>
            <input type="text" id="lseat-botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label class="label-field min-h-12 flex items-center font-mono" for="lseat-email">
              {formFieldLabel}<span class="text-electric-cyan" aria-hidden="true">{formRequiredMark}</span>
            </label>
            <input
              type="email"
              id="lseat-email"
              name="email"
              class="input-field font-mono"
              required
              autocomplete="email"
              inputmode="email"
              aria-required="true"
            />
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">{formSubmitLabel}</button>
        </form>
      </div>

      <div id="lseat-contact-details" class="technical-cell flex flex-col gap-5" tabindex="-1">
        <address class="flex items-start gap-3 not-italic">
          <MapPin class="mt-1 h-4 w-4 shrink-0 text-electric-cyan" stroke-width="1.75" aria-hidden="true" focusable="false" />
          <span class="text-body-base text-pure-white/90">
            15/23 Avenue Arnaud Fraiteur<br />
            1050 Brussels<br />
            Belgium
          </span>
        </address>

        <a
          href={'mailto:' + directEmail}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >{directEmail}</a>

        <a
          href={'mailto:' + generalEmail}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >{generalEmail}</a>

        <a
          href={'tel:' + phoneDigits}
          class="contact-line font-mono tabular-nums text-body-base text-electric-cyan"
        >{phoneDisplay}</a>

        <p class="font-mono text-caption uppercase text-pure-white/55">{companyLine}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const ENDPOINT = 'https://api.web3forms.com/submit';

  const initContactForm = (): void => {
    const form = document.getElementById('lseat-contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.lseatReady === 'true') return;
    form.dataset.lseatReady = 'true';

    const details = document.getElementById('lseat-contact-details');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
    const accessKey = (form.getAttribute('data-access-key') || '').trim();

    form.addEventListener('submit', (event: Event) => {
      event.preventDefault();

      /* Honeypot: silent abort, no request emitted. */
      if (honeypot && honeypot.value.trim() !== '') {
        form.reset();
        return;
      }

      if (accessKey === '') return;

      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        payload[key] = String(value);
      });
      payload.access_key = accessKey;
      payload.botcheck = '';

      void fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        redirect: 'follow',
      })
        .then((response) => {
          if (!response.ok) return;
          /* No success copy exists in the legacy source, so the form steps aside
             and the direct contact channels - which the visitor has just read -
             become the terminal state of the interaction. */
          form.hidden = true;
          if (details instanceof HTMLElement) details.focus();
        })
        .catch(() => {
          /* Left untouched on failure: the form stays exactly as it was. */
        });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true });
  } else {
    initContactForm();
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .technical-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .technical-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .technical-cell {
    background-color: #0b192c;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .technical-cell {
      padding: 2rem;
    }
  }

  .technical-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }

  /* 48px minimum touch target, negative margin keeps the text on the grid. */
  .contact-line {
    display: flex;
    align-items: center;
    min-height: 3rem;
    width: fit-content;
    text-decoration: underline;
    text-decoration-color: rgba(0, 210, 254, 0.35);
    text-underline-offset: 0.3rem;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .contact-line:hover {
    color: #ffffff;
    text-decoration-color: currentColor;
  }

  #lseat-contact-details:focus {
    outline: none;
  }

  #lseat-contact-details:focus-visible {
    outline: 2px solid #00d2fe;
    outline-offset: 4px;
  }
</style>