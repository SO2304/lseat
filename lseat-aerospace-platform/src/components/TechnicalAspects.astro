---
/**
 * TechnicalAspects.astro - the live /compliances page, transcribed verbatim.
 *
 * Rendered copy: technicalTitle, technicalLead and technicalGroups, exactly as
 * the origin publishes them.
 *
 * RETAINED SOURCE TYPOS AND DEFECTS, all from the live origin:
 *   "compmnents"           /compliances, PART 21G production sentence
 *   "subcontracters ."     /compliances, space before the final full stop
 *   "on any aircraft"      /compliances, "adaptable to most seat types on any aircraft"
 *   double space           "Vertical back cushion motion is  synchronised."
 *   double space           "Installation time takes less than 15  minutes per seat"
 *   double space           "It inserts without  seat or cabin modification"
 *
 * There is NO Supplemental Type Certificate on the origin: it reads "LSEAT is
 * supplied with a FORM 1 and PART 21 J engineering work." and no certificate of
 * that kind is named. There is NO kit height either: it reads "Kit size stays within
 * tolerances of seat TSO", and states no measurement of any kind.
 * Neither is reproduced here, and no angle or travel value appears on the origin
 * at all, so none is stated.
 */
import { technicalTitle, technicalLead, technicalGroups } from '../legacy';
---

<section
  id="compliances"
  class="relative scroll-mt-24 bg-slate-dark py-20 md:py-28"
  aria-labelledby="compliances-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <span class="section-badge">Compliances</span>
      <h2
        id="compliances-title"
        class="section-title font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
      >
        {technicalTitle}
      </h2>
      <p class="verbatim mt-5 max-w-3xl font-mono text-body-base text-electric-cyan sm:text-body-lg">
        {technicalLead}
      </p>
    </header>

    <div class="technical-grid mt-12 md:mt-16">
      {
        technicalGroups.map((group) => (
          <div class="technical-cell">
            <h3 class="technical-cell-head font-mono text-caption uppercase tracking-widest text-pure-white/60">
              {group.heading}
            </h3>
            <ul class="flex flex-col gap-4" role="list">
              {group.statements.map((statement) => (
                <li class="flex gap-4">
                  <span class="technical-tick" aria-hidden="true" />
                  <p class="verbatim text-body-base text-pure-white/90">{statement}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!--
      Legacy source typos retained deliberately. The statements above are
      transcribed from the live origin at /compliances exactly as found, and each
      carries a defect that is present in the published text: "compmnents" for
      the misspelt "components", the space before the full stop in
      "subcontracters .", "on any aircraft" in the retrofit sentence, and the
      double spaces in "motion is  synchronised", "less than 15  minutes" and
      "without  seat or cabin modification". The owner instructed an exact
      mirror, so none of them is corrected here. Note that the live origin carries
      no Supplemental Type Certificate and no kit-height figure at all, so
      neither is stated.
    -->
  </div>
</section>

<style>
  /* Same hairline-framed cell register as the benefit sections, over the darker
     surface: 1px dividers drawn with gap + background. */
  .technical-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .technical-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .technical-cell {
    background-color: #0f172a;
    padding: 1.5rem;
  }

  .technical-cell:first-child {
    box-shadow: inset 2px 2px 0 0 rgba(0, 210, 254, 0.5);
  }

  @media (min-width: 768px) {
    .technical-cell {
      padding: 2rem;
    }
  }

  .technical-cell-head {
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .technical-tick {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 1px;
    margin-top: 0.75em;
    background-color: rgba(0, 210, 254, 0.7);
  }
</style>