---
/**
 * TechnicalAspects.astro - the (B) capture, reproduced verbatim.
 *
 * This section is a strict transcription of the archived LSEAT compliance page,
 * captured 20 July 2025. Nothing is reworded, re-ordered beyond the three original
 * group headings, summarised or corrected.
 *
 * RETAINED SOURCE TYPOS - the following defects are present in the archived text
 * and are reproduced on purpose, at the call sites marked below:
 *   "compmnents"      (source spelling, in the PART 21G production sentence)
 *   "staying within"  (source grammar, in the kit size sentence)
 *   "subcontracters ." (space before the final full stop)
 */
import { technicalTitle, technicalLead, technicalGroups } from '../legacy';

---

<section
  id="technical-aspects"
  class="technical-panel relative scroll-mt-24 bg-slate-dark py-20 md:py-28"
  aria-labelledby="technical-aspects-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header>
      <h2
        id="technical-aspects-title"
        class="section-title text-balance font-mono text-[clamp(1.75rem,4.5vw,2.75rem)] font-bold uppercase tracking-tight"
      >
        {technicalTitle}
      </h2>
      <p class="mt-5 max-w-3xl font-mono text-body-base text-electric-cyan text-balance sm:text-body-lg">
        {technicalLead}
      </p>
    </header>

    <dl class="technical-rows mt-12 md:mt-16">
      {
        technicalGroups.map((group) => (
          <div class="technical-row">
            <dt class="technical-row-head font-mono text-caption uppercase tracking-widest text-pure-white/60">
              {group.heading}
            </dt>
            <dd class="technical-row-body">
              <ul class="flex flex-col gap-4" role="list">
                {group.statements.map((statement) => (
                  <li class="flex gap-4">
                    <span class="technical-tick" aria-hidden="true" />
                    <p class="text-body-base text-pure-white/90 text-balance sm:text-body-lg">
                      {statement}
                    </p>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <!--
      Legacy source typos retained deliberately. The three statements below are
      transcribed from the 2025-07-20 capture of the LSEAT compliance page, exactly as
      found, and each carries a defect that is present in the archived original:

        "to staying within tolerances of seat TSO"          - source grammar
        "Production and compmnents are in hands of"          - source spelling
        "PART 21G subcontracters ."                          - space before the stop

      The owner instructed a strict verbatim mirror, so none of them is corrected
      here. Note that astro's compressHTML strips HTML comments from the emitted
      document, so this note lives in the source, not in the shipped HTML.
    -->
  </div>
</section>

<style>
  /* Data-dense register: a two-column definition list separated by 1px rules,
     collapsing to a single column below 900px. */
  .technical-rows {
    display: grid;
    gap: 1px;
    background-color: rgba(0, 210, 254, 0.18);
    border: 1px solid rgba(0, 210, 254, 0.18);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .technical-row {
    display: grid;
    grid-template-columns: 1fr;
    background-color: #0f172a;
  }

  @media (min-width: 900px) {
    .technical-row {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  .technical-row-head {
    padding: 1.25rem 1.5rem;
    background-color: rgba(30, 41, 59, 0.45);
  }

  @media (min-width: 900px) {
    .technical-row-head {
      padding: 1.75rem 2rem;
    }
  }

  .technical-row-body {
    padding: 1.25rem 1.5rem;
  }

  @media (min-width: 900px) {
    .technical-row-body {
      padding: 1.75rem 2rem;
    }
  }

  /* 1px cyan tick in place of a bullet: restrained, technical, no glyph. */
  .technical-tick {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 1px;
    margin-top: 0.75em;
    background-color: rgba(0, 210, 254, 0.7);
  }
</style>