---
/**
 * KinematicViewer3D.astro - interactive 3D kinematics viewer.
 *
 * A real 3D renderer (affine matrices, perspective projection, back-face
 * culling, painter's-algorithm depth sort, flat Lambert shading) painted on a
 * Canvas 2D surface with zero dependencies. The engine lives in
 * src/scripts/kinematic3d.js and is pulled in with a dynamic import(), so it
 * is a separate chunk that is only fetched once the section scrolls into view
 * or the visitor presses the load button.
 *
 * A compact SVG side-view schematic is always present underneath the canvas.
 * It is the loading placeholder, the no-JavaScript view and the fallback if
 * the 3D runtime cannot start.
 */
import { Box, CircleAlert, Layers, LoaderCircle, Move3d, Rotate3d, RotateCcw, Sparkles, ZapOff } from '@lucide/astro';

interface ViewerState {
  id: string;
  code: string;
  name: string;
  subtitle: string;
  angle: number;
  travel: number;
  note: string;
  flags: string[];
}

const states: ViewerState[] = [
  {
    id: 'sitting',
    code: '01',
    name: '16G Upright Sitting Mode',
    subtitle: 'Upright seated position',
    angle: 0,
    travel: 0,
    note: '16G CS-25.562 retention verified',
    flags: ['16G RETENTION ACTIVE', 'HEADREST IN FLIGHT POSITION'],
  },
  {
    id: 'ife',
    code: '02',
    name: 'IFE Watching Mode',
    subtitle: 'Screen viewing position',
    angle: 12,
    travel: 45,
    note: 'IFE clear, no screen occlusion',
    flags: ['IFE CLEAR', 'SEAT PAN ADVANCED 45\u00A0mm'],
  },
  {
    id: 'relax',
    code: '03',
    name: 'Relax Reading Mode',
    subtitle: 'Intermediate position',
    angle: 25,
    travel: 30,
    note: 'Reading angle, lumbar support confirmed',
    flags: ['LUMBAR SUPPORT', 'SEAT PAN ADVANCED 30\u00A0mm'],
  },
  {
    id: 'sleep',
    code: '04',
    name: 'Sleep Mode (40\u00B0 Recline)',
    subtitle: '40\u00B0 recline',
    angle: 40,
    travel: 20,
    note: '40\u00B0 recline with zero intrusion on rear seat pitch',
    flags: ['REAR PITCH PRESERVED', 'SPRING RETURN'],
  },
];

const viewPresets: Array<{ id: string; label: string }> = [
  { id: 'perspective', label: 'Perspective' },
  { id: 'front', label: 'Front' },
  { id: 'side', label: 'Side' },
];

const pillars: Array<{ title: string; body: string; icon: typeof Layers }> = [
  {
    title: '2 composite frames',
    body: 'Two pre-printed carbon frames are inserted under the original seat pan. No rework to the seat structure, no drilling, no seat pan removal.',
    icon: Layers,
  },
  {
    title: '3 moving sub-parts, 0 motors',
    body: 'Front frame, rear frame, return cam. Three moving parts, purely passive transmission, spring return to the upright position for an unoccupied seat.',
    icon: Sparkles,
  },
  {
    title: '0 W, 0 electronics',
    body: 'No power supply, no sensor, no aircraft wiring. 100% mechanical operation, on the ground and in flight, with no EMC impact.',
    icon: ZapOff,
  },
];
---

<section id="kinematic-viewer-3d" class="relative scroll-mt-24 bg-deep-navy py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-grid-pattern bg-grid-64 opacity-50"></div>
  </div>

  <div class="section-container relative">
    <header class="section-header">
      <span class="section-badge">
        <Box class="h-4 w-4" stroke-width="1.75" aria-hidden="true" focusable="false"></Box>
        INTERACTIVE 3D MASS MODEL
      </span>
      <h2 class="section-title">Kinematics in Three Dimensions</h2>
      <p class="section-subtitle text-balance">
        The same four certified positions, rendered as a real 3D solid model you can orbit. Dual composite
        frame system: the upper frame slides forwards and downwards, with synchronised vertical
        back-cushion motion. Only three sub-parts move: no motor, 0&nbsp;W, spring return to upright.
      </p>
    </header>

    <div
      class="glassmorphism-lg rounded-2xl p-5 md:p-8"
      data-k3d
      data-k3d-states={JSON.stringify(states)}
    >
      <h3 class="sr-only">Interactive 3D passenger position viewer</h3>

      <fieldset>
        <legend class="sr-only">Kinematic position selection</legend>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            states.map((state, index) => (
              <div class="relative">
                <input
                  type="radio"
                  name="kin3d-position"
                  id={`kin3d-pos-${state.id}`}
                  value={String(index)}
                  class="peer sr-only"
                  checked={index === 0}
                  data-k3d-radio
                />
                <label
                  for={`kin3d-pos-${state.id}`}
                  class="flex h-full cursor-pointer flex-col gap-1 rounded-xl border border-electric-cyan/20 bg-slate-dark/60 p-4 transition-all duration-300 hover:border-electric-cyan/45 hover:bg-slate-dark/80 peer-checked:border-electric-cyan/70 peer-checked:bg-electric-cyan/10 peer-checked:shadow-glow-cyan peer-focus-visible:ring-2 peer-focus-visible:ring-electric-cyan"
                >
                  <span class="font-mono text-caption text-electric-cyan/70">{state.code}</span>
                  <span class="text-body-base font-semibold text-pure-white">{state.name}</span>
                  <span class="text-body-sm text-pure-white/60">{state.subtitle}</span>
                </label>
              </div>
            ))
          }
        </div>
      </fieldset>
      <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="glassmorphism rounded-xl p-3 md:p-5">
          <div
            class="relative aspect-[4/3] w-full overflow-hidden rounded-lg border border-electric-cyan/18 md:aspect-[5/4]"
            data-k3d-stage
            data-k3d-mode="idle"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 800 500"
              preserveAspectRatio="xMidYMid meet"
              class="absolute inset-0 h-full w-full"
              role="img"
              data-k3d-svg
              aria-label="Schematic side view of the economy seat in the upright seated position: backrest reclined 0 degrees, zero seat pan travel, 16G retention verified."
            >
              <title>Seat kinematics - schematic side view</title>
              <desc>
                Simplified fallback schematic, not to scale. It is shown until the 3D model is loaded, and
                replaces it if the 3D renderer cannot start. The backrest, the seat pan and the passenger
                follow the selected position.
              </desc>

              <defs>
                <linearGradient id="k3d-floor" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0284C7" stop-opacity="0.10"></stop>
                  <stop offset="100%" stop-color="#0B192C" stop-opacity="0"></stop>
                </linearGradient>
                <linearGradient id="k3d-struct" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#1E293B"></stop>
                  <stop offset="100%" stop-color="#0F172A"></stop>
                </linearGradient>
                <linearGradient id="k3d-cushion" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0284C7" stop-opacity="0.50"></stop>
                  <stop offset="100%" stop-color="#0284C7" stop-opacity="0.16"></stop>
                </linearGradient>
                <linearGradient id="k3d-body" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#00D2FE" stop-opacity="0.34"></stop>
                  <stop offset="100%" stop-color="#0284C7" stop-opacity="0.24"></stop>
                </linearGradient>
                <marker id="k3d-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1 L 9 5 L 0 9 z" fill="#00D2FE"></path>
                </marker>
              </defs>

              <rect x="0" y="418" width="800" height="82" fill="url(#k3d-floor)"></rect>
              <line x1="0" y1="418" x2="800" y2="418" stroke="#00D2FE" stroke-opacity="0.22" stroke-width="1"></line>

              <rect x="118" y="406" width="576" height="12" rx="3" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.25"></rect>
              <g stroke="#00D2FE" stroke-opacity="0.30" stroke-width="2">
                <line x1="166" y1="406" x2="166" y2="418"></line>
                <line x1="254" y1="406" x2="254" y2="418"></line>
                <line x1="342" y1="406" x2="342" y2="418"></line>
                <line x1="430" y1="406" x2="430" y2="418"></line>
                <line x1="518" y1="406" x2="518" y2="418"></line>
                <line x1="606" y1="406" x2="606" y2="418"></line>
                <line x1="674" y1="406" x2="674" y2="418"></line>
              </g>

              <g data-k3d-svg-ife opacity="0.32">
                <rect x="566" y="228" width="10" height="178" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.3"></rect>
                <rect x="516" y="140" width="112" height="86" rx="8" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.45"></rect>
                <rect x="526" y="150" width="92" height="66" rx="4" fill="#0284C7" fill-opacity="0.28"></rect>
                <text x="572" y="192" text-anchor="middle" class="fill-current font-mono text-[12px] uppercase tracking-[0.18em] text-pure-white/45 hidden sm:inline">IFE</text>
              </g>

              <g data-k3d-svg-envelope opacity="0.5">
                <line x1="112" y1="60" x2="112" y2="418" stroke="#00D2FE" stroke-opacity="0.40" stroke-width="1" stroke-dasharray="7 7"></line>
                <text x="122" y="404" class="fill-current font-mono text-[12px] uppercase tracking-[0.16em] text-pure-white/45 hidden sm:inline">Rear envelope</text>
              </g>
              <g data-k3d-svg-clearance opacity="0">
                <line x1="112" y1="62" x2="112" y2="76" stroke="#00D2FE" stroke-opacity="0.7" stroke-width="1.5"></line>
                <line data-k3d-svg-clear-line x1="112" y1="69" x2="300" y2="69" stroke="#00D2FE" stroke-opacity="0.7" stroke-width="1.5" marker-start="url(#k3d-arrow)" marker-end="url(#k3d-arrow)"></line>
                <line data-k3d-svg-clear-tick x1="300" y1="62" x2="300" y2="76" stroke="#00D2FE" stroke-opacity="0.7" stroke-width="1.5"></line>
                <circle data-k3d-svg-clear-dot cx="300" cy="69" r="3.5" fill="#00D2FE"></circle>
                <text x="112" y="92" class="fill-current font-mono text-[12px] uppercase tracking-[0.16em] text-pure-white/55 hidden sm:inline">Rear clearance held</text>
              </g>

              <g data-k3d-svg-frames>
                <rect x="286" y="300" width="252" height="16" rx="4" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.35"></rect>
                <rect x="220" y="320" width="188" height="16" rx="4" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.28"></rect>
                <line x1="300" y1="316" x2="300" y2="320" stroke="#00D2FE" stroke-opacity="0.35" stroke-width="2"></line>
                <line x1="500" y1="316" x2="360" y2="320" stroke="#00D2FE" stroke-opacity="0.35" stroke-width="2"></line>
              </g>

              <g data-k3d-svg-pan>
                <rect x="286" y="286" width="252" height="14" rx="6" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.30"></rect>
                <line x1="334" y1="240" x2="468" y2="248" stroke="url(#k3d-body)" stroke-width="28" stroke-linecap="round"></line>
                <line x1="468" y1="248" x2="504" y2="416" stroke="url(#k3d-body)" stroke-width="21" stroke-linecap="round"></line>
                <line x1="504" y1="416" x2="538" y2="424" stroke="url(#k3d-body)" stroke-width="15" stroke-linecap="round"></line>
                <rect x="282" y="254" width="260" height="30" rx="8" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.45"></rect>
                <rect x="288" y="248" width="248" height="12" rx="6" fill="url(#k3d-cushion)"></rect>
              </g>

              <g data-k3d-svg-upper>
                <rect x="270" y="64" width="26" height="236" rx="12" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.45"></rect>
                <rect x="296" y="70" width="18" height="224" rx="9" fill="url(#k3d-cushion)"></rect>
                <rect x="270" y="0" width="40" height="64" rx="14" fill="url(#k3d-struct)" stroke="#00D2FE" stroke-opacity="0.45"></rect>
                <rect x="278" y="8" width="24" height="12" rx="6" fill="url(#k3d-cushion)"></rect>
                <line x1="320" y1="290" x2="318" y2="168" stroke="url(#k3d-body)" stroke-width="36" stroke-linecap="round"></line>
                <circle cx="320" cy="146" r="21" fill="url(#k3d-body)" stroke="#00D2FE" stroke-opacity="0.45"></circle>
              </g>

              <g data-k3d-svg-arc>
                <line x1="300" y1="300" x2="300" y2="176" stroke="#00D2FE" stroke-opacity="0.32" stroke-width="1" stroke-dasharray="4 5"></line>
                <path data-k3d-svg-arc-path d="" fill="none" stroke="#00D2FE" stroke-opacity="0.75" stroke-width="2"></path>
                <line data-k3d-svg-arc-ray x1="300" y1="300" x2="300" y2="176" stroke="#00D2FE" stroke-opacity="0.45" stroke-width="1"></line>
                <text data-k3d-svg-arc-text x="252" y="172" text-anchor="middle" class="k3d-arc-label fill-current font-mono font-semibold text-electric-cyan">0°</text>
              </g>
            </svg>

            <canvas
              class="absolute inset-0 h-full w-full"
              role="application"
              tabindex="0"
              hidden
              data-k3d-canvas
              aria-describedby="kin3d-camera-help"
              aria-label="3D view: 16G Upright Sitting Mode, backrest reclined 0 degrees, seat pan travel 0 millimetres forward."
              >Interactive 3D model of the economy seat. Use the position selector to change the kinematic
              state; the current values are listed in the readout panel.</canvas
            >

            <div class="pointer-events-none absolute inset-0" aria-hidden="true">
              <span class="absolute left-3 top-3 font-mono text-[12px] uppercase tracking-[0.2em] text-pure-white/55">Solid mass model - not to scale</span>
              <span data-k3d-hint class="absolute bottom-3 right-3 font-mono text-[12px] uppercase tracking-[0.16em] text-pure-white/55">Drag to orbit - scroll to zoom</span>
            </div>
          </div>

          <p id="kin3d-camera-help" class="sr-only">
            Interactive 3D model region. Focus the model, then use the arrow keys to rotate it, plus and
            minus to zoom, and zero to reset the camera. The same commands are also available as buttons
            below the model, and the position selector above changes the kinematic state.
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-2" data-k3d-actions>
            <button type="button" class="btn-primary" data-k3d-load>
              <LoaderCircle data-k3d-spinner class="hidden h-5 w-5 animate-spin" stroke-width="1.75" aria-hidden="true" focusable="false"></LoaderCircle>
              <Rotate3d data-k3d-load-icon class="h-5 w-5" stroke-width="1.75" aria-hidden="true" focusable="false"></Rotate3d>
              <span data-k3d-load-label>Load 3D viewer</span>
            </button>

            <div class="flex flex-wrap items-center gap-2" data-k3d-live-controls>
              <button type="button" class="btn-ghost" data-k3d-reset>
                <RotateCcw class="h-4 w-4" stroke-width="1.75" aria-hidden="true" focusable="false"></RotateCcw>
                <span>Reset view</span>
              </button>
              <button type="button" class="btn-ghost" data-k3d-orbit="1">
                <Rotate3d class="h-4 w-4" stroke-width="1.75" aria-hidden="true" focusable="false"></Rotate3d>
                <span>Rotate left</span>
              </button>
              <button type="button" class="btn-ghost" data-k3d-orbit="-1">
                <Rotate3d class="h-4 w-4" stroke-width="1.75" aria-hidden="true" focusable="false"></Rotate3d>
                <span>Rotate right</span>
              </button>
              <button type="button" class="btn-ghost" data-k3d-zoom="0.88">
                <Move3d class="h-4 w-4" stroke-width="1.75" aria-hidden="true" focusable="false"></Move3d>
                <span>Zoom in</span>
              </button>
              <button type="button" class="btn-ghost" data-k3d-zoom="1.14">
                <Move3d class="h-4 w-4" stroke-width="1.75" aria-hidden="true" focusable="false"></Move3d>
                <span>Zoom out</span>
              </button>
            </div>

            <div role="group" aria-label="Camera view presets" class="flex flex-wrap items-center gap-2" data-k3d-live-controls>
              {
                viewPresets.map((preset) => (
                  <button type="button" class="btn-ghost" data-k3d-view={preset.id}>
                    <span>{preset.label}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <p class="mt-3 flex items-start gap-2 text-caption text-pure-white/50" data-k3d-status role="status">
            <CircleAlert data-k3d-status-icon class="hidden h-4 w-4 shrink-0" stroke-width="1.75" aria-hidden="true" focusable="false"></CircleAlert>
            <span data-k3d-status-text>
              The 3D model loads on its own when this section scrolls into view. Seat pan travel is amplified
              for clarity.
            </span>
          </p>
        </div>
        <div class="glassmorphism rounded-xl p-5 md:p-6">
          <div class="flex items-center justify-between gap-3">
            <span class="text-caption text-pure-white/50">Readout</span>
            <span class="badge-tech" data-k3d-out-badge>0°</span>
          </div>

          <p class="mt-4 text-body-base font-semibold text-pure-white" data-k3d-out-name>16G Upright Sitting Mode</p>
          <p class="text-body-sm text-pure-white/60" data-k3d-out-subtitle>Upright seated position</p>

          <dl class="mt-5 space-y-3 text-body-sm">
            <div class="flex items-baseline justify-between gap-3 border-b border-pure-white/10 pb-2">
              <dt class="text-pure-white/55">Backrest recline</dt>
              <dd class="font-mono tabular-nums text-pure-white" data-k3d-out-angle>0°</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3 border-b border-pure-white/10 pb-2">
              <dt class="text-pure-white/55">Seat pan travel</dt>
              <dd class="font-mono tabular-nums text-pure-white" data-k3d-out-travel>0&nbsp;mm</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-pure-white/55">Retention</dt>
              <dd class="font-mono tabular-nums text-pure-white">16G CS-25.562</dd>
            </div>
          </dl>

          <p class="mt-5 text-body-sm text-pure-white/70" data-k3d-out-note>16G CS-25.562 retention verified</p>

          <ul class="mt-4 flex flex-wrap gap-2" data-k3d-out-flags>
            <li class="badge-cert">16G RETENTION ACTIVE</li>
          </ul>
        </div>
      </div>

      <p class="sr-only" aria-live="polite" data-k3d-live></p>

      <p class="mt-4 text-caption text-pure-white/40">
        Solid model of the seat, its two composite frames, the passenger mass and the seat-back IFE screen.
        The rear envelope annotation is drawn in Sleep Mode only. Seat pan travel is amplified for clarity.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          pillars.map((pillar) => {
            const PillarIcon = pillar.icon;
            return (
            <article class="glassmorphism-card">
              <span
                class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-electric-cyan/25 bg-electric-cyan/10 text-electric-cyan [&>svg]:h-5 [&>svg]:w-5"
              >
                <PillarIcon stroke-width="1.75" aria-hidden="true" focusable="false" />
              </span>
              <h4 class="mt-4 text-body-base font-semibold text-pure-white">{pillar.title}</h4>
              <p class="mt-2 text-body-sm text-pure-white/70">{pillar.body}</p>
            </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The schematic is driven by the rAF tween in the script, never by a CSS
     transition, so the two easers can never fight over the same attribute. */
  [data-k3d-canvas] {
    touch-action: none;
  }

  /* The SVG schematic is the placeholder, the no-JavaScript view and the
     fallback; it is only removed from the box once the canvas can take over. */
  [data-k3d-stage][data-k3d-mode='live'] [data-k3d-svg] {
    display: none;
  }

  /* The camera and preset buttons are no-ops until the runtime returns a handle, so they
     stay hidden until it does. The two control groups are SIBLINGS of the stage, not
     descendants: they sit in the action row, which is a following sibling of the stage.
     The general-sibling combinator is therefore the structurally correct operator here.
     Specificity is (0,4,0) as authored (three attribute selectors plus :not()), and Astro
     injects its own scope attribute into each of the four compounds, so the emitted rule is
     (0,7,0): six scoping and data attributes plus the one inside :not().
     That outranks the Tailwind .flex display utility no matter which stylesheet lands
     first in <head>, so byte order can never resurrect the buttons. */
  [data-k3d-stage]:not([data-k3d-mode='live']) ~ [data-k3d-actions] [data-k3d-live-controls] {
    display: none;
  }

  [data-k3d-spinner] {
    animation-duration: 900ms;
  }

  /* The live angle label is the one annotation that cannot be hidden on a phone, so it is
     sized in user units like every other label in this SVG and stepped by media query.
     The stage is width-limited (aspect 4/3 below md, 5/4 from md, both narrower than the
     800-unit viewBox), so the render scale is stageWidth / 800 and the visual size is
     fontSize * scale. The tiers keep it between 9.1 and 14.3 CSS px at every width:
       <=479px   stage 258-377   scale 0.3225-0.4713 -> 30u = 9.7-14.1px
       480-639   stage 378-537   scale 0.4725-0.6713 -> 20u = 9.5-13.4px
       640-767   stage 522-649   scale 0.6525-0.8113 -> 14u = 9.1-11.4px
       768-1023  stage 610-865   scale 0.7625-1.0813 -> 13u = 9.9-14.1px
       1024-1279 stage 510-765   scale 0.6375-0.9563 -> 15u = 9.6-14.3px
       >=1280    stage 758       scale 0.9475       -> 12u = 11.4px
     The label keeps its runtime x/y from paintSvg, so the arc geometry is untouched; at the
     largest tier the three glyphs are 54 user units wide, well clear of the 124-unit arc
     and of the backrest column at x=270. */
  .k3d-arc-label {
    font-size: 12px;
  }

  @media (max-width: 479px) {
    .k3d-arc-label {
      font-size: 30px;
    }
  }

  @media (min-width: 480px) and (max-width: 639px) {
    .k3d-arc-label {
      font-size: 20px;
    }
  }

  @media (min-width: 640px) and (max-width: 767px) {
    .k3d-arc-label {
      font-size: 14px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .k3d-arc-label {
      font-size: 13px;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .k3d-arc-label {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-k3d-spinner] {
      animation: none;
    }
  }
</style>
<script>
  interface ViewerState {
    id: string;
    code: string;
    name: string;
    subtitle: string;
    angle: number;
    travel: number;
    note: string;
    flags: string[];
  }

  interface ViewerHandle {
    setState(index: number, animate?: boolean): void;
    setView(name: string): void;
    reset(): void;
    zoom(factor: number): void;
    nudge(yaw: number, pitch: number): void;
    setReduced(next: boolean): void;
    refresh(): void;
  }

  type ViewerFactory = (
    canvas: HTMLCanvasElement,
    states: ViewerState[],
    options: { reduced: boolean },
  ) => ViewerHandle | null;

  const NBSP = '\u00A0';

  // Schematic-fallback geometry. Same coupling ratio and easing as the 3D
  // runtime and the 2D simulator, in a much smaller drawing.
  const HX = 300;
  const HY = 300;
  const SCALE = 1.9;
  const COUPLE = 0.16;
  const ARC_R = 124;
  const TIP_X = 283;
  const TIP_Y = 32;
  const DURATION = 600;

  const ease = (() => {
    const ax = 1 - 3 * 0.3 + 3 * 0.16;
    const bx = 3 * 0.3 - 6 * 0.16;
    const cx = 3 * 0.16;
    const ay = 1 - 3 * 1 + 3 * 1;
    const by = 3 * 1 - 6 * 1;
    const cy = 3 * 1;
    const curve = (t: number, a: number, b: number, c: number): number => ((a * t + b) * t + c) * t;
    const slope = (t: number, a: number, b: number, c: number): number => 3 * a * t * t + 2 * b * t + c;
    return (x: number): number => {
      if (x <= 0) return 0;
      if (x >= 1) return 1;
      let t = x;
      for (let i = 0; i < 8; i += 1) {
        const d = slope(t, ax, bx, cx);
        if (d === 0) break;
        t -= (curve(t, ax, bx, cx) - x) / d;
      }
      if (t < 0) t = 0;
      if (t > 1) t = 1;
      return curve(t, ay, by, cy);
    };
  })();

  const setAttr = (el: Element | null, name: string, value: string): void => {
    if (el) el.setAttribute(name, value);
  };

  document.querySelectorAll<HTMLElement>('[data-k3d]').forEach((root) => {
    let states: ViewerState[];
    try {
      states = JSON.parse(root.getAttribute('data-k3d-states') || '[]');
    } catch (error) {
      return;
    }
    if (!states.length) return;

    const stage = root.querySelector<HTMLElement>('[data-k3d-stage]');
    const svg = root.querySelector<SVGElement>('[data-k3d-svg]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-k3d-canvas]');
    const loadBtn = root.querySelector<HTMLButtonElement>('[data-k3d-load]');
    const spinner = root.querySelector<SVGElement>('[data-k3d-spinner]');
    const loadIcon = root.querySelector<SVGElement>('[data-k3d-load-icon]');
    const loadLabel = root.querySelector<HTMLElement>('[data-k3d-load-label]');
    const statusIcon = root.querySelector<SVGElement>('[data-k3d-status-icon]');
    const statusText = root.querySelector<HTMLElement>('[data-k3d-status-text]');
    const live = root.querySelector<HTMLElement>('[data-k3d-live]');
    const outAngle = root.querySelector<HTMLElement>('[data-k3d-out-angle]');
    const outTravel = root.querySelector<HTMLElement>('[data-k3d-out-travel]');
    const outBadge = root.querySelector<HTMLElement>('[data-k3d-out-badge]');
    const outName = root.querySelector<HTMLElement>('[data-k3d-out-name]');
    const outSubtitle = root.querySelector<HTMLElement>('[data-k3d-out-subtitle]');
    const outNote = root.querySelector<HTMLElement>('[data-k3d-out-note]');
    const outFlags = root.querySelector<HTMLElement>('[data-k3d-out-flags]');

    const svgFrames = root.querySelector('[data-k3d-svg-frames]');
    const svgPan = root.querySelector('[data-k3d-svg-pan]');
    const svgUpper = root.querySelector('[data-k3d-svg-upper]');
    const svgIfe = root.querySelector('[data-k3d-svg-ife]');
    const svgClear = root.querySelector('[data-k3d-svg-clearance]');
    const svgEnvelope = root.querySelector('[data-k3d-svg-envelope]');
    const svgClearLine = root.querySelector('[data-k3d-svg-clear-line]');
    const svgClearTick = root.querySelector('[data-k3d-svg-clear-tick]');
    const svgClearDot = root.querySelector('[data-k3d-svg-clear-dot]');
    const svgArcPath = root.querySelector('[data-k3d-svg-arc-path]');
    const svgArcRay = root.querySelector('[data-k3d-svg-arc-ray]');
    const svgArcText = root.querySelector('[data-k3d-svg-arc-text]');

    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('[data-k3d-radio]'));
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = motionQuery.matches;

    let viewer: ViewerHandle | null = null;
    let current = 0;
    let mode: 'idle' | 'loading' | 'live' | 'fallback' = 'idle';
    let rafId = 0;
    let announceId = 0;

    const round = (value: number): string => String(Math.round(value));

    const setMode = (next: typeof mode): void => {
      mode = next;
      setAttr(stage, 'data-k3d-mode', next);
    };

    const say = (text: string, warn = false): void => {
      if (statusText) statusText.textContent = text;
      if (statusIcon) statusIcon.classList.toggle('hidden', !warn);
    };

    /* ------------------------------------------------- schematic fallback */

    const tipPoint = (angle: number, dx: number) => {
      const vx = TIP_X - HX;
      const vy = TIP_Y - HY;
      const rad = (angle * Math.PI) / 180;
      return {
        x: HX + vx * Math.cos(rad) + vy * Math.sin(rad) + dx,
        y: HY - vx * Math.sin(rad) + vy * Math.cos(rad),
      };
    };

    const paintSvg = (angle: number, travel: number): void => {
      const dx = travel * SCALE;
      const shift = dx.toFixed(2);
      setAttr(svgFrames, 'transform', 'translate(' + shift + ' 0)');
      setAttr(svgPan, 'transform', 'translate(' + shift + ' 0) rotate(' + (angle * COUPLE).toFixed(3) + ' ' + HX + ' ' + HY + ')');
      setAttr(svgUpper, 'transform', 'translate(' + shift + ' 0) rotate(' + (-angle).toFixed(3) + ' ' + HX + ' ' + HY + ')');

      const rad = (angle * Math.PI) / 180;
      const ex = HX - ARC_R * Math.sin(rad);
      const ey = HY - ARC_R * Math.cos(rad);
      setAttr(svgArcPath, 'd', angle < 0.2 ? '' : 'M ' + HX + ' ' + (HY - ARC_R) + ' A ' + ARC_R + ' ' + ARC_R + ' 0 0 0 ' + ex.toFixed(2) + ' ' + ey.toFixed(2));
      setAttr(svgArcRay, 'x2', ex.toFixed(2));
      setAttr(svgArcRay, 'y2', ey.toFixed(2));
      setAttr(svgArcText, 'x', (HX - ARC_R * Math.sin(rad / 2) - 44).toFixed(2));
      setAttr(svgArcText, 'y', (HY - ARC_R * Math.cos(rad / 2) - 6).toFixed(2));
      if (svgArcText) svgArcText.textContent = round(angle) + '°';

      const tip = tipPoint(angle, dx);
      setAttr(svgClearLine, 'x2', tip.x.toFixed(2));
      setAttr(svgClearTick, 'x1', tip.x.toFixed(2));
      setAttr(svgClearTick, 'x2', tip.x.toFixed(2));
      setAttr(svgClearDot, 'cx', tip.x.toFixed(2));
      setAttr(svgClear, 'opacity', states[current].id === 'sleep' ? '1' : '0');
      setAttr(svgEnvelope, 'opacity', states[current].id === 'sleep' ? '1' : '0.5');
      setAttr(svgIfe, 'opacity', states[current].id === 'ife' ? '1' : '0.32');
    };

    /* ----------------------------------------------------------- selection */

    const select = (index: number, animate: boolean): void => {
      const from = states[current] || states[index];
      const to = states[index];
      if (!to) return;
      current = index;

      const angle = round(to.angle);
      const travel = round(to.travel);
      const tail = to.id === 'sleep' ? ', zero intrusion on rear seat pitch' : '';

      if (outAngle) outAngle.textContent = angle + '°';
      if (outTravel) outTravel.textContent = travel + NBSP + 'mm';
      if (outBadge) outBadge.textContent = angle + '°';
      if (outName) outName.textContent = to.name;
      if (outSubtitle) outSubtitle.textContent = to.subtitle;
      if (outNote) outNote.textContent = to.note;
      if (outFlags) {
        outFlags.textContent = '';
        to.flags.forEach((flag: string) => {
          const item = document.createElement('li');
          item.className = 'badge-cert';
          item.textContent = flag;
          outFlags.appendChild(item);
        });
      }

      setAttr(svg, 'aria-label', 'Schematic side view: ' + to.name + ', backrest reclined ' + angle + ' degrees, seat pan travel ' + travel + ' millimetres forward' + tail + '.');
      setAttr(canvas, 'aria-label', '3D view: ' + to.name + ', backrest reclined ' + angle + ' degrees, seat pan travel ' + travel + ' millimetres forward' + tail + '.');

      if (announceId) window.clearTimeout(announceId);
      announceId = window.setTimeout(() => {
        if (live) live.textContent = to.name + ' - ' + to.subtitle + '. Backrest recline ' + angle + ' degrees, seat pan travel ' + travel + ' millimetres. ' + to.note + '.';
      }, 400);

      if (viewer) viewer.setState(index, animate);

      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;

      if (mode === 'live' || !animate || reduced) {
        paintSvg(to.angle, to.travel);
        return;
      }

      const start = performance.now();
      const step = (now: number): void => {
        const progress = Math.min(1, (now - start) / DURATION);
        const e = ease(progress);
        paintSvg(from.angle + (to.angle - from.angle) * e, from.travel + (to.travel - from.travel) * e);
        rafId = progress < 1 ? requestAnimationFrame(step) : 0;
      };
      rafId = requestAnimationFrame(step);
    };

    /* ------------------------------------------------------------- loading */

    const idleLoadButton = (): void => {
      if (spinner) spinner.classList.add('hidden');
      if (loadIcon) loadIcon.classList.remove('hidden');
      if (loadLabel) loadLabel.textContent = 'Load 3D viewer';
    };

    const boot = (): void => {
      if (mode === 'loading' || mode === 'live') return;
      setMode('loading');
      if (spinner) spinner.classList.remove('hidden');
      if (loadIcon) loadIcon.classList.add('hidden');
      if (loadLabel) loadLabel.textContent = 'Loading 3D viewer...';
      say('Loading the 3D model.');

      import('../scripts/kinematic3d.js')
        .then((mod) => {
          const factory = (mod as unknown as { createViewer3D: ViewerFactory }).createViewer3D;
          if (typeof factory !== 'function') throw new Error('3D runtime unavailable');
          if (canvas) canvas.hidden = false;
          const handle = factory(canvas as HTMLCanvasElement, states, { reduced });
          if (!handle) {
            if (canvas) canvas.hidden = true;
            setMode('fallback');
            idleLoadButton();
            say('This browser could not start the 3D renderer, so the schematic side view is shown instead. All four positions remain selectable.', true);
            return;
          }
          viewer = handle;
          setAttr(svg, 'aria-hidden', 'true');
          setMode('live');
          handle.setState(current, false);
          say('3D model ready. Drag to orbit, scroll or pinch to zoom, double-click or press 0 to reset the camera. The arrow keys work when the model has focus.');
          if (spinner) spinner.classList.add('hidden');
          if (loadIcon) loadIcon.classList.remove('hidden');
          if (loadLabel) loadLabel.textContent = 'Refresh 3D view';
        })
        .catch(() => {
          if (canvas) canvas.hidden = true;
          setMode('fallback');
          idleLoadButton();
          say('The 3D model could not be downloaded, so the schematic side view is shown instead. All four positions remain selectable.', true);
        });
    };

    if (loadBtn) {
      loadBtn.addEventListener('click', () => {
        if (viewer) viewer.refresh();
        else boot();
      });
    }

    root.querySelectorAll<HTMLElement>('[data-k3d-reset]').forEach((btn) => {
      btn.addEventListener('click', () => { if (viewer) viewer.reset(); });
    });
    root.querySelectorAll<HTMLElement>('[data-k3d-orbit]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (viewer) viewer.nudge(0.14 * Number(btn.dataset.k3dOrbit), 0);
      });
    });
    root.querySelectorAll<HTMLElement>('[data-k3d-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (viewer) viewer.zoom(Number(btn.dataset.k3dZoom));
      });
    });
    root.querySelectorAll<HTMLElement>('[data-k3d-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (viewer && btn.dataset.k3dView) viewer.setView(btn.dataset.k3dView);
      });
    });

    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) select(Number(radio.value), true);
      });
    });

    motionQuery.addEventListener('change', (event) => {
      reduced = event.matches;
      if (reduced) {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
        const to = states[current];
        if (to) paintSvg(to.angle, to.travel);
      }
      if (viewer) viewer.setReduced(reduced);
    });

    if (typeof IntersectionObserver === 'function') {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            boot();
          }
        },
        { rootMargin: '200px' },
      );
      observer.observe(root);
    } else {
      boot();
    }

    select(0, false);
  });
</script>