---
/**
 * ProductCards.astro
 * Engineering reference cards: the mechanism drawing and the cabin installation
 * photographs, restored from the archived lseat.eu CDN harvest.
 *
 * Every image listed here was opened and inspected before it was copied. Generic
 * airliner stock photography, the third-party Unsplash frame, the revenue table, the
 * "EASA FAA Compliant" logo graphic and the duplicated demo variants were all left in
 * the archive and are deliberately NOT shipped. See README for the full list.
 *
 * Each card carries an engineering tag, and every tag is derived from the caption that
 * was written after the frame itself was inspected. The tags name what the photograph
 * actually depicts - an installed cabin retrofit, a relax position, a kit component -
 * and never a test result or a specification figure the image does not show. A dynamic
 * crash test, a kit profile measurement and an installation-time claim are engineering
 * values, not things a cabin photograph can evidence, so none of them is used here.
 *
 * width/height are the true pixel dimensions of each file, read from its header, so the
 * browser reserves the box before the bytes arrive and CLS stays at 0.
 */
import { ImageOff } from '@lucide/astro';

interface Card {
  src: string;
  alt: string;
  caption: string;
  note: string;
  tag: string;
  width: number;
  height: number;
}

const cards: Card[] = [
  {
    src: '/media/lseat-mechanism-drawing.jpg',
    alt: 'Two side-view line drawings of the LSEAT seat mechanism, views 4c and 4d, with the seat pan travel dimension and the recline angle callouts marked.',
    caption: 'Coupled glide mechanism',
    tag:
      'Drawing \u00B7 side views 4c / 4d',
    note: 'Side view 4c / 4d, with the seat pan travel dimension and the recline angle callouts.',
    width: 836,
    height: 430,
  },
  {
    src: '/media/lseat-cabin-sleep-mode.jpg',
    alt: 'Economy cabin with an LSEAT seat in full sleep recline, seat-back inflight entertainment screen in the foreground.',
    caption: 'Sleep mode, 40\u00B0 recline',
    tag:
      'Installed retrofit \u00B7 40\u00B0 sleep recline, IFE serviceable',
    note: 'Full recline in a single-seat block, IFE serviceable in the same position.',
    width: 1400,
    height: 934,
  },
  {
    src: '/media/lseat-cabin-relax-ife.jpg',
    alt: 'Reclined LSEAT economy seats beside the cabin window, seat-back screens visible.',
    caption: 'Relax reading mode',
    tag:
      'Installed retrofit \u00B7 intermediate recline, IFE in passenger view',
    note: 'Intermediate recline with the IFE in clear view of the seated passenger.',
    width: 640,
    height: 480,
  },
  {
    src: '/media/lseat-cabin-installed.jpg',
    alt: 'Installed LSEAT seats in an economy cabin row with two passengers seated.',
    caption: 'Installed cabin block',
    tag:
      'Installed retrofit \u00B7 in situ, no seat-track leg removed',
    note: 'Retrofit in situ: no seat track legs removed, no cabin sidewall modification.',
    width: 476,
    height: 356,
  },
  {
    src: '/media/lseat-cabin-relax.jpg',
    alt: 'LSEAT economy seats in the relax position with passengers seated upright.',
    caption: 'Relax position in service',
    tag:
      'Installed retrofit \u00B7 spring return to sitting position',
    note: 'Spring return holds an unoccupied seat in the upright sitting position.',
    width: 466,
    height: 454,
  },
  {
    src: '/media/lseat-seat-pair-ife.jpg',
    alt: 'A pair of upright LSEAT economy seats with seat-back inflight entertainment screens and armrests.',
    caption: 'Upright sitting mode',
    tag:
      'Installed retrofit \u00B7 upright, seat pitch unchanged',
    note: 'Seat density unchanged: the kit occupies no additional pitch.',
    width: 427,
    height: 640,
  },
  {
    src: '/media/lseat-cabin-in-service.jpg',
    alt: 'LSEAT economy cabin in service, a passenger working on a laptop at a reclined seat beside the window.',
    caption: 'Cabin in service',
    tag:
      'Installed retrofit \u00B7 passive mechanism, 0 W',
    note: 'Day cabin operation: the mechanism is passive and adds no electrical load.',
    width: 1400,
    height: 788,
  },
  {
    src: '/media/lseat-seat-cushion.jpg',
    alt: 'Seat cushion assembly with black anti-slip strips on the seat pan, photographed on the cabin floor.',
    caption: 'Seat cushion assembly',
    tag:
      'Kit component \u00B7 cushion replaced, seat structure untouched',
    note: 'Kit component: the cushion is removed and replaced, the seat structure is untouched.',
    width: 640,
    height: 427,
  },
];
---

<section
  id="media"
  class="relative scroll-mt-24 py-24 md:py-32"
  aria-labelledby="media-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header class="section-header">
      <span class="section-badge">Restored records</span>
      <h2 id="media-title" class="section-title text-balance">
        Mechanism Drawing <span class="text-electric-cyan">&amp;</span> Cabin Record
      </h2>
      <p class="section-subtitle text-balance">
        Photographs and the mechanism drawing recovered from the archived lseat.eu CDN
        publication. Every frame on this page was inspected before publication.
      </p>
    </header>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
      {
        cards.map((card) => (
          <li
            class="flex h-full flex-col gap-3 rounded-xl border border-electric-cyan/20 bg-slate-dark/50 p-2 transition-colors duration-400 hover:border-electric-cyan/40"
            role="listitem"
          >
            <div class="flex items-center justify-center overflow-hidden rounded-lg bg-deep-navy/60 p-2">
              <img
                src={card.src}
                alt={card.alt}
                width={card.width}
                height={card.height}
                loading="lazy"
                decoding="async"
                class="h-auto max-h-56 w-auto max-w-full rounded-md object-contain"
              />
            </div>
            <div class="flex flex-1 flex-col gap-2 px-3 pb-3 pt-4">
              <span class="badge-tech self-start">{card.tag}</span>
              <h3 class="text-body-base font-semibold text-pure-white">{card.caption}</h3>
              <p class="text-body-sm text-pure-white/60">{card.note}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 flex items-start gap-2.5 text-body-sm text-pure-white/60">
      <ImageOff class="mt-0.5 h-4 w-4 shrink-0 text-pure-white/40" stroke-width="1.75" aria-hidden="true" focusable="false" />
      <span class="max-w-3xl text-balance">
        Archival imagery published by LSEAT on its previous platform. Cabins and seats shown
        are LSEAT installations; the drawing is the published mechanism view. No image on this
        page is presented as a certification artefact.
      </span>
    </p>
  </div>
</section>
