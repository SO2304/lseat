---
/**
 * InterviewGallery.astro
 * On-demand interview player.
 *
 * LSEAT's own interview publication from the Dubai Air Show, embedded from the
 * youtube-nocookie.com domain rather than self-hosted. Embedding replaces the
 * former 31.55 MiB WebM, which sat over the 25 MiB per-file ceiling of the CDN and
 * made the site undeployable; the embed costs zero bytes of repository weight.
 *
 * The nocookie host is deliberate: it reduces the tracking footprint a third-party
 * frame would otherwise impose on an EU-hosted engineering site.
 *
 * No autoplay parameter is present. loading="lazy" defers the frame until it nears
 * the viewport, and referrerpolicy="strict-origin-when-cross-origin" withholds the
 * full referrer from the embed host. The iframe is keyboard focusable by default
 * and needs no script of its own: starting playback is entirely the visitor's
 * decision.
 */
import { Film } from '@lucide/astro';

const embedSrc = 'https://www.youtube-nocookie.com/embed/hjRS-EZgkbY?start=26&rel=0';
const embedTitle = 'LSEAT interview recorded at the Dubai Air Show';
---

<section
  id="interview"
  class="relative scroll-mt-24 py-24 md:py-32"
  aria-labelledby="interview-title"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid-64 pointer-events-none opacity-60" aria-hidden="true"></div>

  <div class="section-container relative">
    <header class="section-header">
      <span class="section-badge">Company publication</span>
      <h2 id="interview-title" class="section-title text-balance">
        Interview Footage <span class="text-electric-cyan">&amp;</span> Field Record
      </h2>
      <p class="section-subtitle text-balance">
        An interview recorded by LSEAT at the Dubai Air Show, published on the company's
        own channel and embedded here. Playback is entirely on demand.
      </p>
    </header>

    <figure class="glassmorphism-lg mx-auto max-w-4xl overflow-hidden rounded-2xl">
      <div
        class="relative aspect-video w-full overflow-hidden rounded-xl border border-electric-cyan/20 bg-slate-dark shadow-2xl"
      >
        <iframe
          class="absolute inset-0 h-full w-full border-0"
          src={embedSrc}
          title={embedTitle}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <figcaption class="flex flex-col gap-3 border-t border-pure-white/10 p-5 md:p-6">
        <p class="flex items-center gap-2.5 text-caption font-semibold uppercase tracking-widest text-pure-white/70">
          <span
            class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-pure-white/10 bg-slate-dark/70 text-aero-blue"
            aria-hidden="true"
          >
            <Film class="h-4 w-4" stroke-width="1.75" focusable="false" />
          </span>
          LSEAT published interview &middot; Dubai Air Show
        </p>
        <p class="text-body-sm text-pure-white/70 text-balance">
          This interview was recorded by LSEAT at the Dubai Air Show and published on the
          company's own channel. It is presented here as a company publication: the footage, the
          audio and the on-screen graphics are LSEAT's own. Nothing recorded in this interview
          constitutes an LSEAT specification, certification claim or engineering commitment. The
          engineering values published elsewhere on this site remain the authoritative figures.
        </p>
      </figcaption>
    </figure>
  </div>
</section>
