---
/**
 * index.astro - the origin's home route, "/".
 *
 * Block order follows the origin's own home page, top to bottom:
 *   1. the hero, headline over a full-bleed background fill
 *   2. "How it works...(video)" and the origin's own Vimeo embed
 *   3. "See Flyer" and the origin's single "Download PDF" action
 * then the route index, which is navigation chrome this mirror needs and which
 * the origin does not carry, and then the footer.
 *
 * There is no further editorial section on the origin's home page. Nothing is
 * added below the three blocks above except that index.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Flyer from '../components/Flyer.astro';
import RouteIndex from '../components/RouteIndex.astro';
import { homeHeadline, technicalLead } from '../legacy';

const title = `LSEAT - ${homeHeadline}`;
const description = `${homeHeadline}. ${technicalLead}`;
---

<BaseLayout title={title} description={description}>
  <Hero />
  <HowItWorks />
  <Flyer />
  <RouteIndex />
</BaseLayout>