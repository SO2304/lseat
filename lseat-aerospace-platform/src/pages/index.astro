---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Concept from '../components/Concept.astro';
import Benefits from '../components/Benefits.astro';
import TechnicalAspects from '../components/TechnicalAspects.astro';
import ContactForm from '../components/ContactForm.astro';
import { tagline, conceptBody } from '../legacy';

const title = `LSEAT - ${tagline}`;
const description = `${tagline}. ${conceptBody}`;
---

<BaseLayout title={title} description={description}>
  <Hero />
  <Concept />
  <Benefits />
  <TechnicalAspects />
  <ContactForm />
</BaseLayout>